# 本项目的密钥模板。复制为同目录 .env 并填真实值：
#   cp scenarios/example/.env.example scenarios/example/.env
# scenarios/*/.env 均已 .gitignore（除本 .env.example），切勿入库。
# 非密端点（baseUrl / apiPrefix / authType）在同目录 config.json 里配置。

# 鉴权策略（可选，覆盖 config.json 里的 authType）：none | bearer | hmac
# AUTH_TYPE=hmac

# —— authType=hmac 时需要（HMAC 签名鉴权）——
# 签名 = HMAC-SHA256(PROJECT_SECRET, 实际发送字节)，projectId 随签名注入头。
# 注入的头名由策略决定：骨架默认中性 x-project-id/x-signature；具体网关在
# scenarios/<项目|组>/auth.ts 导出 AUTH_STRATEGY 覆盖（见 docs/notes/auth-and-signing.md）。
PROJECT_ID=
PROJECT_SECRET=

# —— authType=bearer 时需要（Authorization: Bearer <token>）——
# ACCESS_TOKEN=

# —— authType=none 时无需任何凭据 ——

# 可选覆盖（留空则用 config.json 里的值）：
# BASE_URL=
# API_PREFIX=

# 可选：请求超时（毫秒），默认 30000
# HTTP_TIMEOUT_MS=30000

# 可选：设为 1 打印每个请求的鉴权摘要（脱敏），便于排查签名/鉴权不一致
# DEBUG_SIGN=0
