# 每环境密钥模板。按环境复制并填真实值，例如：
#   cp .env.example .env.stable
#   cp .env.example .env.dev
# .env.* 均已 .gitignore（除本模板），切勿入库。
# 非密端点（baseUrl / apiPrefix / authType）在 environments.json 里按环境配置。

# 鉴权策略（可选，覆盖 environments.json 里该环境的 authType）：none | bearer | hmac
# AUTH_TYPE=hmac

# —— authType=hmac 时需要（HMAC 签名鉴权）——
# 签名 = HMAC-SHA256(PROJECT_SECRET, 实际发送字节)，projectId 随签名注入头。
PROJECT_ID=
PROJECT_SECRET=

# —— authType=bearer 时需要（Authorization: Bearer <token>）——
# ACCESS_TOKEN=

# —— authType=none 时无需任何凭据 ——

# 可选覆盖（留空则用 environments.json 里该环境的值）：
# BASE_URL=
# API_PREFIX=

# 可选：请求超时（毫秒），默认 30000
# HTTP_TIMEOUT_MS=30000

# 可选：设为 1 打印每个请求的鉴权摘要（脱敏），便于排查签名/鉴权不一致
# DEBUG_SIGN=0
