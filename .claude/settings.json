{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm start:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(node --import tsx:*)",
      "Bash(npx tsx:*)",
      "Bash(git submodule:*)",
      "PowerShell(pnpm install:*)",
      "PowerShell(pnpm start:*)",
      "PowerShell(pnpm typecheck:*)",
      "PowerShell(git submodule:*)"
    ]
  }
}
